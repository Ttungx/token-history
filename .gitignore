# Per-machine config. Each host sets its own alias here, so committing it would
# make the two machines fight over one file — and the alias-to-real-machine
# mapping is deliberately kept out of the public repo.
config.json

# Local run logs
*.log

# Windows scheduled-task entries (machine-specific): .bat runs it by hand,
# .pyw is the pythonw.exe launcher the 20:00 task points at, so it stays silent
th-collect.*

# OS X garbage
.DS_Store

# Python
__pycache__/
*.pyc
.venv/

# ccusage is pinned in package-lock.json; node_modules is regenerated by `npm ci`
node_modules/
